<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/register_background"
    android:orientation="vertical">

    <android.widget.TimePicker
        android:id="@+id/timePicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginBottom="300dp"
        android:headerBackground="#6D5C00"
        android:numbersSelectorColor="#6D5C00" />

    <TextView
        android:id="@+id/selectedDate"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:gravity="center"
        android:textColor="@color/edit_text_background_color" />

    <Button
        android:id="@+id/btnBookAppointment"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:layout_margin="16dp"
        android:layout_marginTop="300dp"
        android:background="@drawable/btn_background"
        android:text="set an appoitment"
        android:textColor="@color/edit_text_background_color" />

    <Button
        android:id="@+id/btnUpdateAppointment"
        android:layout_width="wrap_content"
        android:layout_height="63dp"
        android:layout_margin="16dp"
        android:layout_marginTop="300dp"
        android:background="@drawable/btn_background"
        android:text="Update Appointment"
        android:textColor="@color/edit_text_background_color" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
